# =============================================
# 🌐 Configuration générale de l'application
# =============================================
APP_NAME="Easy Planning"
APP_ENV=local               # local | production | staging
APP_DEBUG=true              # false en production
APP_URL=http://localhost
FRONTEND_URL=http://localhost:4200

# Clé générée automatiquement : "php artisan key:generate"
APP_KEY=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# =============================================
# ⚙️  Performances
# =============================================
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# =============================================
# 📝 Logs
# =============================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================
# 🗃 Base de données
# =============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=easy_planning    # Nom de la base de données
DB_USERNAME=root            # Utilisateur MySQL
DB_PASSWORD=                # ⚠️ Ne pas commit le vrai mot de passe

# =============================================
# 📦 Sessions & Caches
# =============================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync       # "database" en production pour traiter les mails

# =============================================
# 📢 Broadcasting & Filesystem
# =============================================
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# =============================================
# 🖧 Redis (optionnel)
# =============================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================
# 📧 Configuration mail (SMTP)
# =============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=example@gmail.com       # ⚠️ Email d'envoi (ne pas mettre ton perso)
MAIL_PASSWORD=xxxxxx                  # ⚠️ Mot de passe d'application Gmail
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=example@gmail.com
MAIL_FROM_NAME="Easy Planning"

# =============================================
# ☁️ AWS (optionnel)
# =============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================
# 🖥 Frontend Vite
# =============================================
VITE_APP_NAME="${APP_NAME}"
